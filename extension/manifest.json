{
  "manifest_version": 3,
  "name": "Distill — Video to PDF Notes",
  "version": "0.1.0",
  "description": "Capture any video lesson and get a concise, readable PDF.",
  "permissions": ["tabCapture", "activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
